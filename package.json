{
  "name": "coding-agent-harness",
  "version": "1.0.0",
  "description": "A CLI coding agent harness built from scratch",
  "main": "dist/cli/index.js",
  "bin": { "harness": "./dist/cli/index.js" },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npx tsx demo/01-guardrail-intercept.ts && npx tsx demo/03-deep-dimension.ts",
    "start": "node dist/cli/index.js"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "yaml": "^2.4.0",
    "openai": "^4.50.0",
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/generative-ai": "^0.20.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.12.0",
    "tsx": "^4.10.0"
  }
}